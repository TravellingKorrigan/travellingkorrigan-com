---
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in collections.all -%}
{% unless item.url == "/sitemap.xml" or item.url == "/404.html" -%}
<url><loc>{{ global.url }}{{ item.url }}</loc><lastmod>{{ item.date | date_to_xmlschema }}</lastmod></url>
{% endunless -%}
{% endfor -%}
</urlset>
