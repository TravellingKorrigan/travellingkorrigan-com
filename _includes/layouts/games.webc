<!doctype html>
<script webc:setup>
  function gamesFor(games, locale) {
    return games.filter((game) => game.data.locale === locale);
  }
</script>
<html :lang="locale">
<head>
  <meta webc:is="head-commons" webc:nokeep
        :@title="title + ' | ' + global.title" :@description="description" :@url="page.url"
        :@image="image" :@locale="locale">

  <style @raw="getBundle('css')" webc:keep></style>
  <script @raw="getBundle('js')" webc:keep></script>
</head>
<body>
  <main>
    <site-header></site-header>
    <section class="prose">
      <div @html="content"></div>
      <div class="game-list">
        <game-card webc:for="game of gamesFor(collections.games, locale)"
          :@title="game.data.title" :@url="game.url" :@image="game.data.card_image"
          :@brief="game.data.brief" :@status="strings[locale].status[game.data.status]"></game-card>
      </div>
    </section>
    <site-footer></site-footer>
  </main>
</body>
</html>

<style>
  .game-list {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }
</style>
